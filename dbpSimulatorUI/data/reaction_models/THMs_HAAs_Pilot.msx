[TITLE]


[OPTIONS]
AREA_UNITS     M2
RATE_UNITS     DAY
SOLVER     EUL
TIMESTEP     300
ATOL     0.001
RTOL     0.001

[SPECIES]
BULK C_FRA MG 0.01 0.001 
BULK C_SRA MG 0.01 0.001
BULK CL2 MG 0.01 0.001
BULK THMs UG 0.01 0.001
BULK HAAs UG 0.01 0.001


[COEFFICIENTS]
PARAMETER A 0.1 
PARAMETER B 10
PARAMETER T 20
PARAMETER Y_THM 35
PARAMETER Y_HAA 20
PARAMETER R_fast 2.00
PARAMETER R_slow 0.1562
PARAMETER R_factor 1

[TERMS]
Km 1.5826e-4 * RE^0.88 / D
KWAL A*exp(-B*CL2)
Kfast R_factor*R_fast *exp(-12300*(20-T)/(273+20)/(273+T)) ;Fisher 2016
Kslow R_factor*R_slow *exp(-12300*(20-T)/(273+20)/(273+T)) ;Fisher 2016


[PIPES]
RATE CL2 -Kfast*C_FRA*CL2-Kslow*C_SRA*CL2 - ((4/D)*(KWAL/(1+KWAL/Km)))*CL2
RATE C_FRA -Kfast*C_FRA*CL2
RATE C_SRA -Kslow*C_SRA*CL2
RATE THMs Y_THM*(Kfast*C_FRA*CL2+Kslow*C_SRA*CL2)
RATE HAAs Y_HAA*(Kfast*C_FRA*CL2+Kslow*C_SRA*CL2)


[TANKS]
RATE CL2 -Kfast*C_FRA*CL2-Kslow*C_SRA*CL2
RATE C_FRA -Kfast*C_FRA*CL2
RATE C_SRA -Kslow*C_SRA*CL2
RATE THMs Y_THM*(Kfast*C_FRA*CL2+Kslow*C_SRA*CL2)
RATE HAAs Y_HAA*(Kfast*C_FRA*CL2+Kslow*C_SRA*CL2)


[SOURCES]

[QUALITY]

[PARAMETERS]

[PATTERNS]
TankTOCPAT 1
TankCL2PAT 1
WTPTOCPAT 1
WTPCL2PAT 1
[REPORT]
NODES ALL
LINKS ALL
